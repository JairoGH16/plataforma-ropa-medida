generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String
  password            String
  role                Role                @default(CLIENT)
  phone               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  measurement         Measurement?
  manufacturerProfile ManufacturerProfile?
  sentQuotes          QuoteRequest[]      @relation("ClientQuotes")
  receivedQuotes      QuoteRequest[]      @relation("ManufacturerQuotes")
}

model QuoteRequest {
  id             String            @id @default(cuid())
  clientId       String
  client         User              @relation("ClientQuotes", fields: [clientId], references: [id], onDelete: Cascade)
  manufacturerId String
  manufacturer   User              @relation("ManufacturerQuotes", fields: [manufacturerId], references: [id], onDelete: Cascade)
  garmentType    String
  description    String
  status         QuoteStatus       @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum QuoteStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model ManufacturerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty    String?
  garmentTypes String?
  description  String?
  location     String?
  experience   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Measurement {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  talla       String?
  cuello      Float?
  pecho       Float?
  cintura     Float?
  cadera      Float?
  largoManga  Float?
  largoPierna Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  CLIENT
  MANUFACTURER
  ADMIN
}
